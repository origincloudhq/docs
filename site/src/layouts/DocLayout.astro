---
import SiteHead from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import AnalyticsNoScript from '../components/AnalyticsNoScript.astro'
import NavTree from '../components/NavTree.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import MarkdownActions from '../components/MarkdownActions.astro'
import { buildGuideTree, ancestorsOf, availabilityLabel, urlOf, type Doc } from '../lib/nav'
import { markdownPath } from '../lib/markdown'
import { EDIT_GUIDE, reportIssueUrl, sourcePath } from '../lib/source'

interface Heading { depth: number; slug: string; text: string }
const { entry, siblings, guides, headings = [] } = Astro.props as {
  entry: Doc
  siblings: Doc[]          // every page in this guide
  guides: { name: string; label: string; url: string }[]
  headings?: Heading[]
}

const d = entry.data
const tree = buildGuideTree(siblings)
const trail = ancestorsOf(entry, siblings)
const guideName = entry.id.split('/')[0]
const guideRoot = siblings.find((s) => s.data.parent === null)

// `related` holds ids scoped to this guide.
const byId = new Map(siblings.map((s) => [s.data.id, s]))
const related = (d.related ?? []).map((id) => byId.get(id)).filter(Boolean) as Doc[]

const toc = d.toc === false ? [] : headings.filter((h) => h.depth === 2 || h.depth === 3)
const canonical = d.canonical ?? new URL(urlOf(entry), Astro.site ?? 'https://docs.origincloud.eu').href
const pageTitle = d.seo_title ?? `${d.title} | Origin Cloud Docs`
const eyebrow = d.eyebrow ?? `${guideRoot?.data.nav_title ?? guideName} / ${d.page_type}`
const availability = availabilityLabel(entry)
const markdown = markdownPath(urlOf(entry))

// Every page links to how it is changed and to an issue about it. The page's
// own address, not its canonical, goes into the issue: that is what the reader
// was looking at. The source path is for maintainers, who change the page
// there; everyone else follows CONTRIBUTING.md.
const pageUrl = new URL(urlOf(entry), Astro.site ?? 'https://docs.origincloud.eu').href
const source = sourcePath(entry.filePath)
if (!source) throw new Error(`${entry.id}: the loader gave no file path`)
---
<!doctype html>
<html lang="en">
<head>
  {/* Description and canonical are required by the frontmatter schema, so a
      page cannot ship without them. */}
  <SiteHead title={pageTitle} description={d.description} canonical={canonical} noindex={d.noindex} {markdown} />
</head>
<body>
  <AnalyticsNoScript />
  <a class="skip-link" href="#content">Skip to content</a>

  <SiteHeader />

  <div class="shell">
    <nav class="sidebar" aria-label="Documentation">
      {/*
        Collapsible on narrow screens only. With five pages the sidebar was a
        short preamble; with a 23-page guide tree it buries the content below
        the fold. Default `open`, so with no JavaScript the behaviour is
        unchanged — the script closes it only on a narrow viewport.
      */}
      <details class="sidebar-box" open>
        <summary class="sidebar-box__toggle">Browse this guide</summary>
      <label class="guide-switch">
        <span class="guide-switch__label">Guide</span>
        <select onchange="location.href=this.value">
          {guides.map((g) => (
            <option value={g.url} selected={g.name === guideName}>{g.label}</option>
          ))}
        </select>
      </label>
      <NavTree nodes={tree} currentId={entry.id} />
      </details>
    </nav>

    <script is:inline>
      // Narrow screens only, and only when scripting is available: without
      // this the <details> stays open, which is the previous behaviour.
      try {
        const box = document.querySelector('.sidebar-box')
        if (box && window.matchMedia('(max-width: 767px)').matches) box.open = false
      } catch {}
    </script>

    {/* Only the page itself goes into the search index: without this, every
        excerpt starts with the header's links and the tree. Pages without the
        attribute (the landing page, the 404) are left out of the index. */}
    <main class="main" id="content" data-pagefind-body>
      <Breadcrumbs trail={trail} current={entry} />

      <div class="doc-head">
        <p class="oc-eyebrow">{eyebrow}</p>
        <h1>{d.title}</h1>
        {availability && (
          <p class="doc-head__availability" data-availability={d.availability}>{availability}</p>
        )}
        {d.lead && <p class="doc-head__lead">{d.lead}</p>}
        {(d.specs ?? []).length > 0 && (
          <ul class="oc-chips doc-head__specs">
            {(d.specs ?? []).map((s) => (
              <li class="oc-chip"><span class="chip__label">{s.label}</span> {s.value}</li>
            ))}
          </ul>
        )}
      </div>

      <article class="doc-body"><slot /></article>

      {related.length > 0 && (
        <aside class="related" aria-labelledby="related-h">
          <h2 id="related-h" class="related__title">Related pages</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={urlOf(r)}>{r.data.nav_title ?? r.data.title}</a>
                <span class="related__desc">{r.data.description}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <aside class="page-actions" aria-label="Improve this page" data-pagefind-ignore>
        <a href={EDIT_GUIDE}>Edit this page</a>
        <a href={reportIssueUrl(pageUrl, d.title)}>Report an issue</a>
        <MarkdownActions href={markdown} variant="row" />
        <span class="page-actions__source" title="Where maintainers change this page">Source: <code>{source}</code></span>
      </aside>

      {d.last_reviewed && (
        <p class="page-reviewed">Last reviewed {d.last_reviewed.toISOString().slice(0, 10)}</p>
      )}
    </main>

    <aside class="oc-toc toc" aria-label="On this page">
      <p class="oc-toc__title">On this page</p>
      <ol>
        {toc.map((h) => (
          <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
      <MarkdownActions href={markdown} variant="rail" />
    </aside>
  </div>

  <SiteFooter />

  <script>
    // Highlight the TOC entry for the section currently on screen.
    const links = new Map<string, HTMLAnchorElement>()
    document.querySelectorAll<HTMLAnchorElement>('.oc-toc a').forEach((a) =>
      links.set(decodeURIComponent(a.hash.slice(1)), a)
    )
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          links.forEach((a) => a.removeAttribute('aria-current'))
          links.get(e.target.id)?.setAttribute('aria-current', 'true')
        })
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    )
    targets.forEach((t) => observer.observe(t))
  </script>
</body>
</html>
