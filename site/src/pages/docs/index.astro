---
import { getCollection } from 'astro:content'
import { guideRank } from '../../lib/nav'
import SiteHead from '../../components/SiteHead.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GuideGrid from '../../components/GuideGrid.astro'
import AnalyticsNoScript from '../../components/AnalyticsNoScript.astro'

// One entry per guide, from each guide's own root page, ordered by its
// nav_order so the landing page and the guide switcher agree.
const all = await getCollection('docs')
const docs = all
  .filter((d) => d.data.parent === null)
  .sort((a, b) => guideRank(a.id.split('/')[0]) - guideRank(b.id.split('/')[0]))
const pageCount = all.length
const site = Astro.site ?? 'https://docs.origincloud.eu'
const description =
  'User documentation for Origin Cloud: one guide per service, for anyone calling the API or the origin CLI.'
---
<!doctype html>
<html lang="en">
<head>
  <SiteHead title="Origin Cloud Docs" description={description} canonical={new URL('/docs/', site).href} ogType="website" />
</head>
<body>
  <AnalyticsNoScript />
  <a class="skip-link" href="#content">Skip to content</a>

  <SiteHeader />

  <main id="content">
    <section class="oc-section oc-section--docs">
      <div class="oc-container oc-container--full landing">
        <div class="doc-head">
          <p class="oc-eyebrow">User documentation</p>
          <h1>Origin Cloud documentation</h1>
          <p class="doc-head__lead">
            What the platform can do, written for someone calling the GraphQL API
            or the <code>origin</code> CLI, not for someone reading the source. One
            guide per service, each covering the capabilities you can use and the
            parts of the platform's own process you need in order to automate
            around it.
          </p>
          <ul class="oc-chips doc-head__specs">
            <li class="oc-chip"><span class="chip__label">Interface</span> GraphQL · origin CLI</li>
            <li class="oc-chip"><span class="chip__label">Guides</span> {docs.length}</li>
            <li class="oc-chip"><span class="chip__label">Pages</span> {pageCount}</li>
            <li class="oc-chip"><span class="chip__label">Search</span> Press /</li>
          </ul>
        </div>

        <h2 class="landing__group">Service guides</h2>
        <GuideGrid guides={docs} headingLevel={3} />

        {/* The way back into the site. Someone reading the docs is mid-evaluation,
            which is the moment "what does it cost" and "what else is there" get
            asked, and the landing page would otherwise answer neither. */}
        <h2 class="landing__group" id="offsite-heading">On origincloud.eu</h2>
        <div class="oc-grid oc-products" aria-labelledby="offsite-heading">
          <a class="oc-product oc-col-12 oc-col-sm-6 oc-col-lg-4" href="https://www.origincloud.eu/cloud-services/">
            <h3 class="oc-product__title">All services</h3>
            <p class="oc-product__text">What is live today, and what is planned.</p>
          </a>
          <a class="oc-product oc-col-12 oc-col-sm-6 oc-col-lg-4" href="https://www.origincloud.eu/compute/pricing/">
            <h3 class="oc-product__title">Compute rates</h3>
            <p class="oc-product__text">Published hourly, per instance type.</p>
          </a>
          <a class="oc-product oc-col-12 oc-col-sm-6 oc-col-lg-4" href="https://www.origincloud.eu/pvs/pricing/">
            <h3 class="oc-product__title">Volume rates</h3>
            <p class="oc-product__text">Published per provisioned GiB, per month.</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</body>
</html>
