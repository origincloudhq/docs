---
import { getCollection } from 'astro:content'
import { guideRank } from '../../lib/nav'
import SiteHead from '../../components/SiteHead.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GuideGrid from '../../components/GuideGrid.astro'
import AnalyticsNoScript from '../../components/AnalyticsNoScript.astro'
import MarkdownActions from '../../components/MarkdownActions.astro'
import { LANDING_DESCRIPTION, LANDING_LEAD, LANDING_TITLE, OFFSITE } from '../../lib/landing'
import { markdownPath } from '../../lib/markdown'

// One entry per guide, from each guide's own root page, ordered by its
// nav_order so the landing page and the guide switcher agree.
const all = await getCollection('docs')
const docs = all
  .filter((d) => d.data.parent === null)
  .sort((a, b) => guideRank(a.id.split('/')[0]) - guideRank(b.id.split('/')[0]))
const pageCount = all.length
const site = Astro.site ?? 'https://docs.origincloud.eu'
const markdown = markdownPath('/docs/')
// The lead's only markup is inline code: odd parts are between backticks.
const lead = LANDING_LEAD.split('`')
---
<!doctype html>
<html lang="en">
<head>
  <SiteHead title="Origin Cloud Docs" description={LANDING_DESCRIPTION} canonical={new URL('/docs/', site).href} ogType="website" {markdown} />
</head>
<body>
  <AnalyticsNoScript />
  <a class="skip-link" href="#content">Skip to content</a>

  <SiteHeader />

  <main id="content">
    <section class="oc-section oc-section--docs">
      <div class="oc-container oc-container--full landing">
        <div class="doc-head">
          <div class="doc-head__top">
            <p class="oc-eyebrow">User documentation</p>
            <MarkdownActions href={markdown} />
          </div>
          <h1>{LANDING_TITLE}</h1>
          <p class="doc-head__lead">
            {lead.map((part, i) => (i % 2 ? <code>{part}</code> : part))}
          </p>
          <ul class="oc-chips doc-head__specs">
            <li class="oc-chip"><span class="chip__label">Interface</span> GraphQL · origin CLI</li>
            <li class="oc-chip"><span class="chip__label">Guides</span> {docs.length}</li>
            <li class="oc-chip"><span class="chip__label">Pages</span> {pageCount}</li>
            <li class="oc-chip"><span class="chip__label">Search</span> Press /</li>
          </ul>
        </div>

        <h2 class="landing__group">Service guides</h2>
        <GuideGrid guides={docs} headingLevel={3} />

        {/* The way back into the site (lib/landing.ts says why). */}
        <h2 class="landing__group" id="offsite-heading">On origincloud.eu</h2>
        <div class="oc-grid oc-products" aria-labelledby="offsite-heading">
          {OFFSITE.map((o) => (
            <a class="oc-product oc-col-12 oc-col-sm-6 oc-col-lg-4" href={o.href}>
              <h3 class="oc-product__title">{o.title}</h3>
              <p class="oc-product__text">{o.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</body>
</html>
