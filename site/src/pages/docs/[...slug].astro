---
import { getCollection, render } from 'astro:content'
import DocLayout from '../../layouts/DocLayout.astro'
import { urlOf, guideOf, guideRank, type Doc } from '../../lib/nav'

export async function getStaticPaths() {
  const docs = await getCollection('docs')

  const byGuide = new Map<string, Doc[]>()
  for (const d of docs) {
    const g = guideOf(d)
    if (!byGuide.has(g)) byGuide.set(g, [])
    byGuide.get(g)!.push(d)
  }

  // Guide switcher options, ordered by each guide root's nav_order so the
  // order matches the docs landing page rather than being alphabetical.
  const guides = [...byGuide.entries()]
    .map(([name, entries]) => {
      const root = entries.find((e) => e.data.parent === null)!
      return {
        name,
        label: root.data.nav_title ?? root.data.title,
        url: `/docs/${name}/`,
        order: guideRank(name),
      }
    })
    .sort((a, b) => a.order - b.order)

  return docs.map((entry) => ({
    // urlOf gives "/docs/<path>/"; the route param is that without the prefix.
    params: { slug: urlOf(entry).replace(/^\/docs\//, '').replace(/\/$/, '') },
    props: { entry, siblings: byGuide.get(guideOf(entry))!, guides },
  }))
}

const { entry, siblings, guides } = Astro.props
const { Content, headings } = await render(entry)
---
<DocLayout {entry} {siblings} {guides} {headings}>
  <Content />
</DocLayout>
