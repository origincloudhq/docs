---
import { getCollection } from 'astro:content'
import { guideRank } from '../lib/nav'
import SiteHead from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import GuideGrid from '../components/GuideGrid.astro'
import AnalyticsNoScript from '../components/AnalyticsNoScript.astro'

// Guide roots only. Listing all 93 pages here would be a worse dead end than
// the 404 itself.
const docs = (await getCollection('docs'))
  .filter((d) => d.data.parent === null)
  .sort((a, b) => guideRank(a.id.split('/')[0]) - guideRank(b.id.split('/')[0]))
---
<!doctype html>
<html lang="en">
<head>
  {/* A 404 is served under many URLs and should never be indexed as a page
      in its own right, or it competes with the real ones in search results. */}
  <SiteHead
    title="Page not found | Origin Cloud Docs"
    description="That page does not exist. The Origin Cloud documentation covers compute, storage, network, IAM and observability."
    ogType="website"
    noindex
  />
</head>
<body>
  <AnalyticsNoScript />
  <a class="skip-link" href="#content">Skip to content</a>

  <SiteHeader />

  <main id="content">
    <section class="oc-section oc-section--docs">
      <div class="oc-container oc-container--full landing">
        <div class="doc-head">
          <p class="oc-eyebrow">Error 404</p>
          <h1>Page not found</h1>
          <p class="doc-head__lead">
            Nothing is served at this address. The page may have been renamed, or
            the link that brought you here may be out of date. The documentation
            describes the platform as it is today, so pages move as it changes.
            Press <kbd>/</kbd> to search.
          </p>
        </div>

        <h2 class="landing__group">Start from one of the service guides</h2>
        <GuideGrid guides={docs} headingLevel={3} />
      </div>
    </section>
  </main>

  <SiteFooter />
</body>
</html>
