---
import { getCollection } from 'astro:content'
import { guideRank } from '../lib/nav'
import '../styles/tokens.css'
import '../styles/docs.css'
import Search from '../components/Search.astro'
import Analytics from '../components/Analytics.astro'
import AnalyticsNoScript from '../components/AnalyticsNoScript.astro'
import PrivacySettings from '../components/PrivacySettings.astro'
import LegalLinks from '../components/LegalLinks.astro'

// Guide roots only. Listing all 93 pages here would be a worse dead end than
// the 404 itself.
const docs = (await getCollection('docs'))
  .filter((d) => d.data.parent === null)
  .sort((a, b) => guideRank(a.id.split('/')[0]) - guideRank(b.id.split('/')[0]))
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found — Origin Cloud Docs</title>
  <meta name="description" content="That page does not exist. The Origin Cloud documentation covers compute, storage, network, IAM and observability." />
  <!-- A 404 is served under many URLs and should never be indexed as a page
       in its own right, or it competes with the real ones in search results. -->
  <meta name="robots" content="noindex, follow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700&family=Public+Sans:wght@400;500;620;650&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <Analytics />
</head>
<body>
  <AnalyticsNoScript />
  <a class="skip-link" href="#content">Skip to content</a>

  <header class="site-header">
    <a class="brand" href="/docs/">
      <span class="brand__mark">Origin Cloud</span>
      <span class="brand__scope">Docs</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="https://www.origincloud.eu/">Site</a>
      <a href="https://console.origincloud.eu/">Console</a>
    </nav>
    <Search />
  </header>

  <main class="landing" id="content">
    <div class="masthead grid-paper brackets">
      <p class="masthead__eyebrow">Error / 404</p>
      <h1>Page not found</h1>
      <p class="masthead__lead">
        Nothing is served at this address. The page may have been renamed, or
        the link that brought you here may be out of date — the documentation
        describes the platform as it is today, so pages do move as it changes.
      </p>
      <div class="masthead__specs">
        <span class="chip"><span class="chip__label">Status</span><span class="chip__value">404</span></span>
        <span class="chip"><span class="chip__label">Search</span><span class="chip__value">Press /</span></span>
      </div>
    </div>

    <p class="notfound-lead">Start from one of the service guides:</p>

    <ul class="cards">
      {docs.map((d, i) => (
        <li>
          <a class="card brackets" href={`/docs/${d.id.replace(/\/index$/, "")}/`}>
            <span class="card__idx">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="card__title">{d.data.nav_title ?? d.data.title}</h2>
            <p class="card__desc">{d.data.description}</p>
          </a>
        </li>
      ))}
    </ul>

    <footer class="page-foot">
      <span>Origin Cloud — user documentation</span>
      <span class="page-foot__links">
        <LegalLinks />
        <PrivacySettings />
      </span>
    </footer>
  </main>
</body>
</html>
