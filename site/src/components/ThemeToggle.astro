---
/**
 * Switches between the light and dark theme and remembers the choice.
 *
 * Until a reader picks one, the page follows the system setting (the script in
 * SiteHead sets it before the first paint, so there is no flash). Two forms:
 * an icon button in the header bar, and a text row in the header's menu,
 * which is where it lives below 992 px. Hidden without JavaScript: those
 * readers get the light theme and no dead control.
 */
const { variant = 'icon' } = Astro.props as { variant?: 'icon' | 'menu' }
---
{variant === 'icon' ? (
  <button class="theme-toggle" type="button" data-theme-toggle hidden>
    <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
) : (
  <button class="theme-toggle-row" type="button" data-theme-toggle data-theme-text hidden>Dark theme</button>
)}

<script is:inline>
  // Both forms render this script; it binds every toggle once.
  (() => {
    if (window.__ocThemeToggle) return
    window.__ocThemeToggle = true
    const root = document.documentElement
    const sync = () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
      document.querySelectorAll('[data-theme-toggle]').forEach((b) => {
        if (b.hasAttribute('data-theme-text')) b.textContent = next === 'dark' ? 'Dark theme' : 'Light theme'
        else { b.setAttribute('aria-label', `Switch to the ${next} theme`); b.title = `Switch to the ${next} theme` }
        b.hidden = false
      })
    }
    document.addEventListener('click', (e) => {
      if (!e.target.closest?.('[data-theme-toggle]')) return
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
      root.dataset.theme = next
      try { localStorage.setItem('oc-theme', next) } catch {}
      sync()
    })
    document.addEventListener('oc-themechange', sync)
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sync)
    else sync()
  })()
</script>
