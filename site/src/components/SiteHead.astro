---
/**
 * The <head> every page shares: brand stylesheets, self-hosted fonts, icons,
 * social metadata and analytics. Page-specific tags go in the slot.
 *
 * Stylesheet order matters: the brand tokens first, the kit's components on
 * them, this site's docs.css last.
 */
import '../styles/brand/tokens.css'
import '../styles/brand/components.css'
import '../styles/docs.css'
import Analytics from './Analytics.astro'

const { title, description, canonical, ogType = 'article', noindex = false } = Astro.props as {
  title: string
  description: string
  canonical?: string
  ogType?: 'article' | 'website'
  noindex?: boolean
}
const site = Astro.site ?? 'https://docs.origincloud.eu'
const ogImage = new URL('/og.png', site).href
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Origin Cloud Docs" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#002E33" />

<link rel="preload" href="/fonts/EncodeSans.ttf" as="font" type="font/ttf" crossorigin />
<link rel="stylesheet" href="/fonts/fonts.css" />

<slot />
<Analytics />
